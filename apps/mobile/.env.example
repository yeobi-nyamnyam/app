SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_CLIENT_ID=-
KAKAO_NATIVE_APP_KEY=
NAVER_MAP_CLIENT_ID=
# NCP Style Editor(style-editor.map.naver.com)로 만든 커스텀 지도 스타일 ID (optional)
NAVER_MAP_STYLE_ID=
# apps/server 주소. 안드로이드 에뮬레이터에서는 localhost가 에뮬레이터 자신을
# 가리키므로 호스트 PC로 접속하려면 http://10.0.2.2:4000 사용 (iOS 시뮬레이터는
# localhost 그대로 동작)
EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:4000
