    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.50.0"
